#!/bin/sh
set -eu
test "$#" = 1 || exit 2
case "$1" in apt-plan|apt-apply|refresh|flatpak-plan|flatpak-apply|flatpak-source) ;; *) exit 2 ;; esac
exec /usr/bin/env -i HOME=/root PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin LANG=C.UTF-8 PKEXEC_UID="${PKEXEC_UID:-0}" /usr/bin/python3 -I /usr/lib/amogos-store/backend/cli.py "$1"
